<?xml version="1.0" ?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

    <link name="base_pan_tilt">
      <visual>
          <geometry>
              <box size="0.037 0.033 0.003"/>
          </geometry>
          <origin xyz="0.004 0 0" rpy="0 0 0"/>
          <material name="black"/>
      </visual>
      <collision>
          <geometry>
              <box size="0.037 0.033 0.003"/>
          </geometry>
          <origin xyz="0.004 0 0" rpy="0 0 0"/>
      </collision>
      <visual>
          <geometry>
              <cylinder radius="0.0125" length="0.011"/>
          </geometry>
          <origin xyz="0 0 0.007" rpy="0 0 0"/>
          <material name="black"/>
      </visual>
      <collision>
          <geometry>
              <cylinder radius="0.0125" length="0.011"/>
          </geometry>
          <origin xyz="0 0 0.007" rpy="0 0 0"/>
      </collision>
      <inertial>
        <mass value="0.02"/>
        <origin xyz="0 0 0.005" rpy="0 0 0"/>
        <inertia ixx="0.000003" ixy="0.0" ixz="0.0" 
                 iyy="0.000003" iyz="0.0" 
                 izz="0.000003"/>
      </inertial>
  </link>

  <link name="part_2_link">
      <visual>
          <geometry>
              <box size="0.035 0.040 0.009"/>
          </geometry>
          <origin xyz="-0.0025 0 0" rpy="0 0 0"/>
          <material name="black"/>
      </visual>
      <collision>
          <geometry>
              <box size="0.035 0.040 0.009"/>
          </geometry>
          <origin xyz="-0.0025 0 0" rpy="0 0 0"/>
      </collision>  
      <visual>
          <geometry>
              <box size="0.045 0.002 0.024"/>
          </geometry>
          <origin xyz="0.0025 0.019 0.0165" rpy="0 0 0"/>
          <material name="black"/>
      </visual>
      <collision>
          <geometry>
              <box size="0.045 0.002 0.024"/>
          </geometry>
          <origin xyz="0.0025 0.019 0.0165" rpy="0 0 0"/>
      </collision>  
      <visual>
          <geometry>
              <box size="0.045 0.002 0.024"/>
          </geometry>
          <origin xyz="0.0025 -0.019 0.0165" rpy="0 0 0"/>
          <material name="black"/>
      </visual>
      <collision>
          <geometry>
              <box size="0.045 0.002 0.024"/>
          </geometry>
          <origin xyz="0.0025 -0.019 0.0165" rpy="0 0 0"/>
      </collision>
      <inertial>
        <mass value="0.03"/>
        <origin xyz="0 0 0.01" rpy="0 0 0"/>
        <inertia ixx="0.00001" ixy="0.0" ixz="0.0" 
                 iyy="0.00001" iyz="0.0" 
                 izz="0.00001"/>
      </inertial>  
  </link>
  <joint name="gripper_roll_joint" type="revolute">
      <parent link="base_pan_tilt"/>
      <child link="part_2_link"/>
      <origin xyz="0 0 0.0172" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.57" upper="1.57" effort="10" velocity="2.0"/>
      <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <link name="part_3_link">
      <visual>
          <geometry>
              <box size="0.012 0.025 0.022"/>
          </geometry>
          <origin xyz="0 0 0.006" rpy="0 0 0"/>
          <material name="blue"/>
      </visual>
      <collision>
          <geometry>
              <box size="0.012 0.025 0.022"/>
          </geometry>
          <origin xyz="0 0 0.006" rpy="0 0 0"/>
      </collision>  
      <visual>
          <geometry>
              <cylinder radius="0.0035" length="0.005"/>
          </geometry>
          <origin xyz="0 0.015 0" rpy="1.57 0 0"/>
          <material name="black"/>
      </visual>
      <collision>
          <geometry>
              <cylinder radius="0.0035" length="0.005"/>
          </geometry>
          <origin xyz="0 0.015 0" rpy="1.57 0 0"/>
      </collision>
      <visual>
          <geometry>
              <cylinder radius="0.0035" length="0.005"/>
          </geometry>
          <origin xyz="0 -0.015 0" rpy="1.57 0 0"/>
          <material name="black"/>
      </visual>
      <collision>
          <geometry>
              <cylinder radius="0.0035" length="0.005"/>
          </geometry>
          <origin xyz="0 -0.015 0" rpy="1.57 0 0"/>
      </collision>
      <inertial>
        <mass value="0.03"/>
        <origin xyz="0 0 0.006" rpy="0 0 0"/>
        <inertia ixx="0.000005" ixy="0.0" ixz="0.0" 
                 iyy="0.000005" iyz="0.0" 
                 izz="0.000005"/>
      </inertial>
  </link>
  <joint name="gripper_pitch_joint" type="revolute">
      <parent link="part_2_link"/>
      <child link="part_3_link"/>
      <origin xyz="0.020 0 0.0235" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.57" upper="1.57" effort="10" velocity="2.0"/>
      <dynamics damping="0.5" friction="0.1"/>
  </joint>

