<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Base Link (Main Body) -->
  <link name="gripper_base">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.04 0.004"/>
      </geometry>
      <material name="plywood_colour"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.04 0.004"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.010"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.000005" ixy="0.0" ixz="0.0" 
               iyy="0.000006" iyz="0.0" 
               izz="0.000008"/>
    </inertial>
  </link>

  <!-- Left Upper Link (Linkage Arm) -->
  <link name="left_upper_link">
    <visual>
      <origin xyz="0.016 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.032 0.005 0.004"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0.016 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.032 0.005 0.004"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.005"/>
      <origin xyz="0.016 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0000005" ixy="0.0" ixz="0.0" 
               iyy="0.0000005" iyz="0.0" 
               izz="0.0000005"/>
    </inertial>
  </link>

  <!-- Left Lower Link (Linkage Arm) -->
  <link name="left_lower_link">
    <visual>
      <origin xyz="0.016 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.032 0.005 0.004"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0.016 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.032 0.005 0.004"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.005"/>
      <origin xyz="0.016 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0000005" ixy="0.0" ixz="0.0" 
               iyy="0.0000005" iyz="0.0" 
               izz="0.0000005"/>
    </inertial>
  </link>

  <!-- Left Finger (Parallel Part) -->
  <link name="left_finger">
    <visual>
      <origin xyz="0.0175 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.035 0.01 0.004"/>
      </geometry>
      <material name="black">
        <color rgba="0.3 0.3 0.3 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.0175 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.035 0.01 0.004"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.005"/>
      <origin xyz="0.0175 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0000013" ixy="0.0" ixz="0.0" 
               iyy="0.0000013" iyz="0.0" 
               izz="0.0000013"/>
    </inertial>
  </link>

  <!-- Right Upper Link (Linkage Arm) -->
  <link name="right_upper_link">
    <visual>
      <origin xyz="0.016 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.032 0.005 0.004"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0.016 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.032 0.005 0.004"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.005"/>
      <origin xyz="0.016 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0000005" ixy="0.0" ixz="0.0" 
               iyy="0.0000005" iyz="0.0" 
               izz="0.0000005"/>
    </inertial>
  </link>

  <!-- Right Lower Link (Linkage Arm) -->
  <link name="right_lower_link">
    <visual>
      <origin xyz="0.016 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.032 0.005 0.004"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0.016 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.032 0.005 0.004"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.005"/>
      <origin xyz="0.016 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0000005" ixy="0.0" ixz="0.0" 
               iyy="0.0000005" iyz="0.0" 
               izz="0.0000005"/>
    </inertial>
  </link>

  <!-- Right Finger (Parallel Part) -->
  <link name="right_finger">
    <visual>
      <origin xyz="0.0175 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.035 0.01 0.004"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0.0175 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.035 0.01 0.004"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.005"/>
      <origin xyz="0.0175 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0000013" ixy="0.0" ixz="0.0" 
               iyy="0.0000013" iyz="0.0" 
               izz="0.0000013"/>
    </inertial>
  </link>

  <!-- LEFT SIDE JOINTS -->
  
  <!-- Joint: Base to Left Upper Link (Actuated - servo) -->
  <joint name="gripper_left_upper_joint" type="revolute">
    <parent link="gripper_base"/>
    <child link="left_upper_link"/>
    <origin xyz="0.019 0.005 0.004" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="1.57" effort="10" velocity="2.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <!-- Joint: Base to Left Lower Link (Passive - mimics upper) -->
  <joint name="left_lower_joint" type="revolute">
    <parent link="gripper_base"/>
    <child link="left_lower_link"/>
    <origin xyz="0.019 0.005 -0.004" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="1.57" effort="10" velocity="2.0"/>
    <dynamics damping="0.5" friction="0.1"/>
    <mimic joint="gripper_left_upper_joint" multiplier="1" offset="0"/>
  </joint>

  <!-- Joint: Left Upper Link to Left Finger -->
  <joint name="left_finger_upper_joint" type="revolute">
    <parent link="left_upper_link"/>
    <child link="left_finger"/>
    <origin xyz="0.032 0 -0.004" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="1.57" effort="10" velocity="2.0"/>
    <dynamics damping="0.5" friction="0.1"/>
    <mimic joint="gripper_left_upper_joint" multiplier="-1" offset="0"/>
  </joint>

  <!-- Joint: Left Lower Link to Left Finger --><!--
  <joint name="left_finger_lower_joint" type="revolute">
    <parent link="left_lower_link"/>
    <child link="left_finger"/>
    <origin xyz="0.032 0 0.004" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="1.57" effort="10" velocity="2.0"/>
    <dynamics damping="0.5" friction="0.1"/>
    <mimic joint="gripper_left_upper_joint" multiplier="-1" offset="0"/>
  </joint>-->

  <!-- RIGHT SIDE JOINTS (Mirror of left side) -->
  
  <!-- Joint: Base to Right Upper Link (Mimic left upper - symmetric) -->
  <joint name="right_upper_joint" type="revolute">
    <parent link="gripper_base"/>
    <child link="right_upper_link"/>
    <origin xyz="0.019 -0.005 0.004" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="1.57" effort="10" velocity="2.0"/>
    <dynamics damping="0.5" friction="0.1"/>
    <mimic joint="gripper_left_upper_joint" multiplier="-1" offset="0"/>
  </joint>

  <!-- Joint: Base to Right Lower Link -->
  <joint name="right_lower_joint" type="revolute">
    <parent link="gripper_base"/>
    <child link="right_lower_link"/>
    <origin xyz="0.019 -0.005 -0.004" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="1.57" effort="10" velocity="2.0"/>
    <dynamics damping="0.5" friction="0.1"/>
    <mimic joint="gripper_left_upper_joint" multiplier="-1" offset="0"/>
  </joint>

  <!-- Joint: Right Upper Link to Right Finger -->
  <joint name="right_finger_upper_joint" type="revolute">
    <parent link="right_upper_link"/>
    <child link="right_finger"/>
    <origin xyz="0.032 0 -0.004" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="1.57" effort="10" velocity="2.0"/>
    <dynamics damping="0.5" friction="0.1"/>
    <mimic joint="gripper_left_upper_joint" multiplier="1" offset="0"/>
  </joint>

  <!-- Joint: Right Lower Link to Right Finger --><!--
  <joint name="right_finger_lower_joint" type="revolute">
    <parent link="right_lower_link"/>
    <child link="right_finger"/>
    <origin xyz="0.032 0 0.004" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="1.57" effort="10" velocity="2.0"/>
    <dynamics damping="0.5" friction="0.1"/>
    <mimic joint="gripper_left_upper_joint" multiplier="1" offset="0"/>
  </joint>-->

</robot>